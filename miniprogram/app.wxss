/* app.wxss - 全局样式 */

/* 设计规范：基于 750rpx 设计稿 */
/* 主色调：暖色系 - 遵循 Web 端设计风格 */

page {
  --color-bg: #f7f2ea;
  --color-bg-warm: #fbf6ef;
  --color-bg-card: #fffaf3;
  --color-bg-white: #ffffff;
  --color-primary: #1f4034;
  --color-primary-light: #2f6b56;
  --color-accent: #ff8b52;
  --color-accent-dark: #e0682e;
  --color-text-primary: #2f281f;
  --color-text-secondary: #7d6a53;
  --color-text-tertiary: #9a8a78;
  --color-border: #eadfce;
  --color-border-light: #efe4d4;
  --color-price: #df6f33;
  --color-badge: #d67635;
  --color-badge-bg: #fff4e8;
  --color-tag-bg: #fff5ea;
  --color-green-bg: #e9f4ef;
  --color-brown-bg: #f6f0e7;
  --color-brown-light: #f7f1e8;
  --color-brown-dark: #51351f;

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--color-text-primary);
  background-color: var(--color-bg);
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view, text, image, navigator {
  box-sizing: border-box;
}

/* 通用类 */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.safe-area-top {
  padding-top: env(safe-area-inset-top);
}

/* 圆角卡片 */
.card {
  background: var(--color-bg-card);
  border-radius: 28rpx;
  border: 2rpx solid var(--color-border);
  box-shadow: 0 24rpx 56rpx rgba(105, 77, 44, 0.08);
  overflow: hidden;
}

/* 按钮 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 36rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 28rpx 56rpx rgba(31, 64, 52, 0.24);
}

.btn-primary:active {
  transform: scale(0.98);
}

.btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 36rpx;
  background: #ffffff;
  border: 2rpx solid #d9c6ae;
  color: var(--color-text-primary);
  font-size: 28rpx;
  font-weight: 600;
}

/* 小标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 24rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.tag-hot {
  background: var(--color-tag-bg);
  color: var(--color-badge);
}

.tag-category {
  background: var(--color-badge-bg);
  color: var(--color-badge);
}

/* 价格 */
.price {
  color: var(--color-price);
  font-weight: 700;
}

.price-original {
  color: #b5a18a;
  text-decoration: line-through;
  font-size: 24rpx;
}

/* 数量步进器 */
.stepper {
  display: flex;
  align-items: center;
  height: 96rpx;
  border-radius: 96rpx;
  background: #fff3e9;
  padding: 8rpx;
}

.stepper-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  font-size: 28rpx;
}

.stepper-btn-minus {
  background: #ffffff;
  color: #855326;
  box-shadow: 0 8rpx 20rpx rgba(120, 93, 53, 0.08);
}

.stepper-btn-plus {
  background: var(--color-primary-light);
  color: #ffffff;
  box-shadow: 0 16rpx 32rpx rgba(47, 107, 86, 0.22);
}

.stepper-count {
  min-width: 40rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #6b4a2b;
}

/* 章节标签 */
.section-label {
  font-size: 22rpx;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.22em;
  color: #c88d55;
}

.section-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.2;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: linear-gradient(180deg, #f6efe4 0%, #f8f4ee 26%, #fbf8f3 60%, #f2ebe0 100%);
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #e4d6c2;
  border-top-color: var(--color-primary-light);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #7d6a53;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
  text-align: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f3e8d8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.empty-title {
  margin-top: 32rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.empty-desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* Toast 提示 */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: var(--color-primary);
  color: #ffffff;
  padding: 24rpx 48rpx;
  border-radius: 60rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 36rpx 64rpx rgba(31, 64, 52, 0.32);
  z-index: 9999;
  animation: toastIn 0.3s ease-out;
}

@keyframes toastIn {
  from {
    transform: translate(-50%, -50%) scale(0.8);
    opacity: 0;
  }
  to {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
}

/* 底部安全区域 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(180deg, rgba(251, 246, 239, 0) 0%, rgba(251, 246, 239, 0.94) 20%, #fbf6ef 100%);
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.bottom-bar-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
  max-width: 686rpx;
  margin: 0 auto;
  border-radius: 48rpx;
  border: 2rpx solid var(--color-border);
  background: rgba(255, 250, 243, 0.92);
  padding: 24rpx;
  box-shadow: 0 36rpx 80rpx rgba(90, 65, 38, 0.12);
  backdrop-filter: blur(8px);
}