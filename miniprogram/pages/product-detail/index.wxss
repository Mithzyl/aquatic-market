/* pages/product-detail/index.wxss */
.page-container { background: radial-gradient(circle at top, rgba(255,242,221,0.88), rgba(245,238,228,0.96) 30%, #f7f2ea 62%, #efe6db 100%); min-height: 100vh; padding-bottom: 180rpx; }
.product-image-section { position: relative; height: 680rpx; }
.product-hero-image { width: 100%; height: 100%; }
.product-image-overlay { position: absolute; left: 0; right: 0; bottom: 0; top: 0; background: linear-gradient(180deg, rgba(25,18,10,0.12) 0%, rgba(25,18,10,0.62) 100%); }
.product-image-tags { position: absolute; left: 32rpx; bottom: 200rpx; display: flex; flex-wrap: wrap; gap: 16rpx; }
.product-category-tag { border-radius: 48rpx; background: rgba(255,244,230,0.18); padding: 8rpx 24rpx; font-size: 24rpx; font-weight: 600; color: #ffffff; }
.product-hot-tag { border-radius: 48rpx; background: rgba(231,122,63,0.9); padding: 8rpx 24rpx; font-size: 24rpx; font-weight: 600; color: #ffffff; }
.product-image-info { position: absolute; left: 40rpx; bottom: 48rpx; right: 40rpx; }
.product-hero-name { font-size: 76rpx; font-weight: 700; color: #ffffff; line-height: 1.08; display: block; }
.product-hero-desc { font-size: 28rpx; color: rgba(255,255,255,0.86); line-height: 1.6; margin-top: 16rpx; display: block; }
.product-detail-card { margin: -56rpx 32rpx 0; border-radius: 68rpx 68rpx 0 0; background: #fffaf3; border-top: 2rpx solid #efe2d0; padding: 48rpx 40rpx; }
.product-price-section { display: flex; align-items: flex-end; justify-content: space-between; }
.product-price-label { font-size: 22rpx; font-weight: 600; text-transform: uppercase; letter-spacing: 0.24em; color: #c88d55; }
.product-price-row { display: flex; align-items: baseline; gap: 16rpx; margin-top: 16rpx; }
.product-price-value { font-size: 76rpx; font-weight: 700; color: #df6f33; line-height: 1; }
.product-original-price { font-size: 32rpx; color: #b49f88; text-decoration: line-through; }
.product-stock-card { border-radius: 48rpx; border: 2rpx solid #eadfce; background: #fbf5ec; padding: 24rpx 32rpx; text-align: right; }
.product-stock-label { font-size: 22rpx; color: #9c8468; }
.product-stock-value { font-size: 36rpx; font-weight: 600; color: #2f281f; margin-top: 8rpx; }
.product-badges { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 40rpx; }
.product-badge { border-radius: 48rpx; background: #fff4e8; padding: 12rpx 24rpx; font-size: 24rpx; font-weight: 500; color: #d67635; }
.product-desc-section { margin-top: 56rpx; }
.product-desc-text { font-size: 30rpx; line-height: 1.7; color: #6c5944; margin-top: 24rpx; }
.product-specs { display: flex; gap: 24rpx; margin-top: 56rpx; border-radius: 60rpx; border: 2rpx solid #eadfce; background: #fbf6ef; padding: 32rpx; }
.spec-item { flex: 1; border-radius: 48rpx; background: #ffffff; padding: 32rpx; box-shadow: 0 20rpx 40rpx rgba(130,96,59,0.05); text-align: center; }
.spec-label { font-size: 22rpx; color: #9d876f; }
.spec-value { font-size: 28rpx; font-weight: 600; color: #2f281f; margin-top: 16rpx; }
.quantity-section { margin-top: 56rpx; border-radius: 60rpx; border: 2rpx solid #eadfce; background: linear-gradient(180deg, #fffaf3 0%, #f8f1e7 100%); padding: 40rpx; }
.quantity-info { margin-bottom: 24rpx; }
.quantity-hint { font-size: 28rpx; color: #7d6a53; margin-top: 16rpx; }
.stepper { display: flex; align-items: center; height: 112rpx; border-radius: 112rpx; background: #fff3e9; padding: 16rpx; }
.stepper-btn { width: 80rpx; height: 80rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 36rpx; font-weight: 600; }
.stepper-btn-minus { background: #ffffff; color: #855326; box-shadow: 0 8rpx 20rpx rgba(120,93,53,0.08); }
.stepper-btn-plus { background: #2f6b56; color: #ffffff; box-shadow: 0 16rpx 32rpx rgba(47,107,86,0.22); }
.stepper-count { min-width: 48rpx; text-align: center; font-size: 32rpx; font-weight: 600; color: #6b4a2b; }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 100; background: linear-gradient(180deg, rgba(251,246,239,0), rgba(251,246,239,0.94) 20%, #fbf6ef 100%); padding: 32rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.bottom-bar-content { display: flex; align-items: center; gap: 24rpx; border-radius: 60rpx; border: 2rpx solid #eadfce; background: rgba(255,250,243,0.92); padding: 24rpx; }
.bottom-btn-outline { flex: 1; height: 112rpx; display: flex; align-items: center; justify-content: center; border-radius: 44rpx; border: 2rpx solid #d9c6ae; background: #ffffff; font-size: 28rpx; font-weight: 600; color: #3f3326; }
.bottom-btn-primary { flex: 1.3; height: 112rpx; display: flex; align-items: center; justify-content: center; gap: 16rpx; border-radius: 44rpx; background: #1f4034; padding: 0 40rpx; font-size: 28rpx; font-weight: 600; color: #ffffff; box-shadow: 0 28rpx 56rpx rgba(31,64,52,0.24); }
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 0 48rpx; }
.empty-icon { font-size: 128rpx; margin-bottom: 32rpx; }
.empty-title { font-size: 52rpx; font-weight: 700; color: #2f281f; }
.empty-desc { font-size: 28rpx; color: #7d6a53; margin-top: 24rpx; text-align: center; }
.empty-btn { margin-top: 48rpx; height: 96rpx; display: flex; align-items: center; justify-content: center; border-radius: 96rpx; background: #1f4034; padding: 0 48rpx; font-size: 28rpx; font-weight: 600; color: #ffffff; }