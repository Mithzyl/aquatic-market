<!-- pages/profile/index.wxml -->
<view class="page-container">
  <view class="profile-header">
    <view class="avatar-wrapper">
      <image class="avatar" src="{{isLoggedIn && userInfo.avatar_url ? userInfo.avatar_url : 'https://api.dicebear.com/7.x/avataaars/svg?seed=user'}}" mode="aspectFill" />
    </view>
    <text class="user-name">{{isLoggedIn && userInfo.nickname ? userInfo.nickname : defaultName}}</text>
    <text class="user-phone" wx:if="{{isLoggedIn && userInfo.phone}}">{{userInfo.phone}}</text>
  </view>

  <!-- 登录/退出按钮 -->
  <view class="auth-section">
    <button class="auth-btn {{isLoggedIn ? 'auth-btn-logout' : 'auth-btn-login'}}" bindtap="{{isLoggedIn ? 'onLogout' : 'onLogin'}}">
      {{isLoggedIn ? '退出登录' : '立即登录'}}
    </button>
  </view>

  <view class="contact-card">
    <view class="contact-item" bindtap="onCallPhone">
      <view class="contact-icon"><text class="contact-icon-emoji">📞</text></view>
      <view class="contact-info">
        <text class="contact-label">联系客服</text>
        <text class="contact-value">{{contactPhone}}</text>
      </view>
      <view class="contact-action"><text>→</text></view>
    </view>
  </view>
</view>