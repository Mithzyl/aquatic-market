/* pages/index/index.wxss - 首页样式 */
.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f6efe4 0%, #f8f4ee 26%, #fbf8f3 60%, #f2ebe0 100%);
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}

/* Hero Section */
.hero-section {
  position: relative;
  overflow: hidden;
  border-radius: 0 0 48rpx 48rpx;
  margin: 24rpx;
}

.hero-bg {
  width: 100%;
  height: 720rpx;
  display: block;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(17, 11, 7, 0.92), rgba(50, 33, 19, 0.58), rgba(18, 11, 7, 0.88));
}

.hero-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  padding: 48rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.hero-tag {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.12);
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.18em;
  color: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(4px);
  align-self: flex-start;
}

.hero-text {
  margin-top: 80rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  display: block;
}

.hero-title {
  font-size: 60rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.1;
  margin-top: 16rpx;
  display: block;
  font-family: 'Noto Serif SC', 'Songti SC', serif;
}

.hero-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.6;
  margin-top: 24rpx;
  display: block;
}

.hero-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}

.hero-btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 96rpx;
  background: #ff8b52;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.hero-btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 96rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  background: rgba(255, 255, 255, 0.1);
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  backdrop-filter: blur(4px);
}

.hero-spotlight {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 64rpx;
}

.hero-spotlight-label {
  font-size: 22rpx;
  text-transform: uppercase;
  letter-spacing: 0.24em;
  color: rgba(255, 255, 255, 0.5);
  display: block;
}

.hero-spotlight-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  margin-top: 8rpx;
  display: block;
}

.hero-spotlight-price-card {
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.1);
  padding: 24rpx 32rpx;
  text-align: right;
  backdrop-filter: blur(4px);
}

.hero-spotlight-price-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
  display: block;
}

.hero-spotlight-price {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  margin-top: 4rpx;
  display: block;
}

/* Service Highlights */
.service-section {
  margin-top: 40rpx;
  padding: 0 32rpx;
}

.service-grid {
  display: flex;
  gap: 24rpx;
}

.service-card {
  flex: 1;
  border-radius: 48rpx;
  border: 2rpx solid #eadfce;
  background: rgba(255, 251, 245, 0.86);
  padding: 24rpx;
  box-shadow: 0 24rpx 52rpx rgba(94, 70, 38, 0.06);
}

.service-stat {
  font-size: 22rpx;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: #b17e4b;
  display: block;
}

.service-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c241b;
  margin-top: 16rpx;
  display: block;
}

.service-desc {
  font-size: 24rpx;
  line-height: 1.5;
  color: #7d6a53;
  margin-top: 16rpx;
  display: block;
}

/* Category Section */
.category-section {
  margin-top: 40rpx;
  padding: 0 32rpx;
}

.category-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.category-link {
  padding: 12rpx 24rpx;
  background: #f6f0e7;
  border-radius: 32rpx;
}

.category-link-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #2f6b56;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  width: calc(20% - 16rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 184rpx;
  border-radius: 44rpx;
  background: #fff4e8;
  padding: 16rpx 8rpx;
}

.category-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f1e6d7;
  margin-bottom: 12rpx;
}

.category-icon-emoji {
  font-size: 36rpx;
}

.category-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #46392c;
  display: block;
  margin-top: 4rpx;
}

.category-desc {
  font-size: 20rpx;
  color: #9a8062;
  display: block;
  margin-top: 4rpx;
}

/* Top Picks */
.picks-section {
  margin-top: 40rpx;
  padding: 0 32rpx;
  padding-bottom: 24rpx;
}

.picks-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.picks-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.pick-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  border-radius: 56rpx;
  border: 2rpx solid #eadfce;
  background: rgba(255, 255, 255, 0.86);
  padding: 24rpx;
  box-shadow: 0 28rpx 64rpx rgba(112, 86, 54, 0.06);
}

.pick-image-wrapper {
  position: relative;
  width: 192rpx;
  height: 192rpx;
  border-radius: 44rpx;
  overflow: hidden;
  background: #f2e9dd;
  flex-shrink: 0;
}

.pick-image {
  width: 100%;
  height: 100%;
}

.pick-tag {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  border-radius: 24rpx;
  background: #51351f;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #ffffff;
}

.pick-info {
  flex: 1;
  min-width: 0;
}

.pick-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pick-category-tag {
  border-radius: 24rpx;
  background: #fff1e5;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #d67635;
}

.pick-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #2c241c;
  margin-top: 12rpx;
  display: block;
}

.pick-desc {
  font-size: 24rpx;
  line-height: 1.5;
  color: #7d6a53;
  margin-top: 8rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.pick-price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 16rpx;
}

.pick-price {
  font-size: 40rpx;
  font-weight: 700;
  color: #e0682e;
}

.pick-original-price {
  font-size: 24rpx;
  color: #b5a18a;
  text-decoration: line-through;
}