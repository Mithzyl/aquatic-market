<!-- pages/order-list/index.wxml -->
<view class="page-container">
  <!-- 未登录状态：显示登录引导 -->
  <view wx:if="{{requireAuth}}" class="auth-required-state">
    <view class="auth-icon">
      <text class="auth-icon-emoji"></text>
    </view>
    <text class="auth-title">请先登录</text>
    <text class="auth-desc">登录后即可查看您的订单记录、追踪订单状态</text>
    <view class="auth-btn" bindtap="onLogin">
      <text>立即登录</text>
    </view>
    <view class="auth-hint">
      <text>还没有账号？登录时将自动为您创建</text>
    </view>
  </view>

  <!-- 已登录状态：显示订单列表 -->
  <block wx:else>
    <view class="header">
    <view class="header-card">
      <view class="header-top">
        <view>
          <view class="header-badge"><view class="header-badge-dot"></view><text>My Orders</text></view>
          <text class="header-title">我的订单</text>
        </view>
        <view class="header-action" bindtap="onGoToOrder"><text>继续下单</text></view>
      </view>
      <view class="stats-grid" wx:if="{{!loading}}">
        <view class="stat-card"><text class="stat-label">待取货</text><text class="stat-value stat-ready">{{orderStats.readyCount}}</text></view>
        <view class="stat-card"><text class="stat-label">待确认</text><text class="stat-value stat-pending">{{orderStats.pendingCount}}</text></view>
        <view class="stat-card"><text class="stat-label">历史订单</text><text class="stat-value stat-completed">{{orderStats.completedCount}}</text></view>
      </view>
    </view>
  </view>

  <view class="filter-section">
    <view class="filter-tabs">
      <view wx:for="{{filterTabs}}" wx:key="key" class="filter-tab {{activeFilter === item.key ? 'filter-tab-active' : ''}}" bindtap="onFilterChange" data-key="{{item.key}}">
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-container"><view class="loading-spinner"></view><text class="loading-text">加载中...</text></view>
  <view wx:elif="{{filteredOrders.length === 0}}" class="empty-state">
    <view class="empty-icon"></view>
    <text class="empty-title">当前没有这类订单</text>
    <text class="empty-desc">切换筛选查看订单，或继续选购好货</text>
    <view class="empty-btn" bindtap="onGoToOrder">去下单</view>
  </view>
  <view wx:else class="order-list">
    <view class="order-card" wx:for="{{filteredOrders}}" wx:key="id">
      <view class="order-header">
        <view class="order-status-badge" style="background: {{item.status === 'preparing' ? '#1f7a55' : item.status === 'pending' ? '#f4b54a' : item.status === 'cancelled' ? '#dc2626' : '#ebe7e1'}}; color: {{item.status === 'preparing' ? '#fff' : item.status === 'pending' ? '#4c3414' : item.status === 'cancelled' ? '#fff' : '#786553'}}">
          <text>{{item.status === 'preparing' ? '待取货' : item.status === 'pending' ? '已下单' : item.status === 'completed' ? '已领取' : item.status === 'cancelled' ? '已取消' : '未知状态'}}</text>
        </view>
        <view class="order-meta"><text class="order-id">订单号 {{item.id}}</text><text class="order-date">{{item.created_at}}</text></view>
      </view>
      <view class="order-body">
        <text class="order-title">{{item.items && item.items.length === 1 ? item.items[0].name : (item.items ? item.items[0].name + '等' + item.items.length + '款鲜货' : '海鲜订单')}}</text>
        <text class="order-amount">¥{{item.total_amount}}</text>
      </view>
      <view class="order-expand" bindtap="onToggleExpand" data-id="{{item.id}}">
        <text>订单明细</text><text class="order-expand-icon">{{expandedOrderId === item.id ? '▲' : '▼'}}</text>
      </view>
      <view wx:if="{{expandedOrderId === item.id && item.items}}" class="order-items">
        <view class="order-item" wx:for="{{item.items}}" wx:key="name" wx:for-item="lineItem">
          <text class="order-item-name">{{lineItem.name}}</text>
          <view class="order-item-meta"><text>x{{lineItem.quantity}}</text><text>¥{{lineItem.price * lineItem.quantity}}</text></view>
        </view>
      </view>
      <!-- 取消订单按钮 -->
      <view wx:if="{{item.status === 'pending' && item.canCancel}}" class="order-cancel-btn" bindtap="onCancelOrderClick" data-id="{{item.id}}">
        <text>取消订单</text>
      </view>
    </view>
  </view>
  </block>
  
  <!-- 取消订单确认对话框 -->
  <view wx:if="{{showCancelDialog}}" class="cancel-dialog-overlay">
    <view class="cancel-dialog">
      <view class="cancel-dialog-header">
        <text class="cancel-dialog-title">取消订单确认</text>
        <text class="cancel-dialog-close" bindtap="onCancelCancel">×</text>
      </view>
      <view class="cancel-dialog-body">
        <view class="cancel-dialog-warning">
          <text class="cancel-dialog-warning-icon">⚠</text>
          <text class="cancel-dialog-warning-text">取消订单后，订单将无法恢复，请确认是否继续。</text>
        </view>
        <view class="cancel-dialog-order-info">
          <text class="cancel-dialog-order-id">订单号：{{orderToCancel.id}}</text>
          <text class="cancel-dialog-order-amount">金额：¥{{orderToCancel.total_amount}}</text>
        </view>
      </view>
      <view class="cancel-dialog-footer">
        <view class="cancel-dialog-btn cancel-dialog-btn-cancel" bindtap="onCancelCancel">
          <text>取消</text>
        </view>
        <view class="cancel-dialog-btn cancel-dialog-btn-confirm {{isCancelling ? 'cancel-dialog-btn-disabled' : ''}}" bindtap="onConfirmCancel">
          <text>{{isCancelling ? '处理中...' : '确认取消'}}</text>
        </view>
      </view>
    </view>
  </view>
</view>