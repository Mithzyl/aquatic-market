<!-- pages/login/index.wxml - 用户登录页 -->
<view class="login-page">
  <!-- Hero 区域 - Logo + 品牌 -->
  <view class="hero-section">
    <!-- Logo -->
    <view class="logo-wrapper">
      <view class="logo-circle">
        <image class="logo-icon" src="/static/images/tab-home-active.png" mode="aspectFit" />
      </view>
    </view>

    <!-- 品牌名 -->
    <text class="brand-name">柳州鲜选</text>
    <text class="brand-slogan">新鲜海鲜，当日送达</text>
  </view>

  <!-- 登录表单 -->
  <view class="form-section">
    <!-- 手机号输入 -->
    <view class="form-item">
      <text class="form-label">手机号</text>
      <view class="input-row">
        <input
          class="input-field"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          value="{{phone}}"
          bindinput="onPhoneInput"
          disabled="{{isLoading}}"
        />
        <button
          class="code-btn {{codeSent ? 'code-btn-sent' : ''}}"
          bindtap="handleSendCode"
          disabled="{{isLoading || isSendingCode || !phone || codeSent}}"
        >
          {{isSendingCode ? '发送中...' : codeSent ? (countdown > 0 ? countdown + 's' : '已发送') : '获取验证码'}}
        </button>
      </view>
    </view>

    <!-- 验证码输入 -->
    <view class="form-item">
      <text class="form-label">验证码</text>
      <input
        class="input-field input-field-full"
        type="number"
        maxlength="6"
        placeholder="请输入 6 位验证码"
        value="{{verifyCode}}"
        bindinput="onVerifyCodeInput"
        disabled="{{isLoading}}"
      />
    </view>

    <!-- 错误提示 -->
    <view class="error-section" wx:if="{{inputError || apiError}}">
      <text class="error-text">{{inputError || apiError}}</text>
    </view>

    <!-- 登录按钮 -->
    <button
      class="login-btn {{isLoading ? 'login-btn-loading' : ''}}"
      bindtap="handleLogin"
      disabled="{{isLoading || !phone || !verifyCode}}"
    >
      {{isLoading ? '登录中...' : '登录'}}
    </button>
  </view>

  <!-- 返回首页 -->
  <view class="footer-section">
    <text class="footer-link" bindtap="goHome">返回首页</text>
  </view>
</view>