# 环境变量配置示例
# 复制此文件为 .env 并根据实际环境修改

# ==================== JWT 配置 ====================
# ⚠️ 安全警告：JWT_SECRET 必须在生产环境中修改！
# - 不要使用默认值或弱密钥
# - 必须是一个强随机字符串（建议至少 32 字符）
# - 生成方式示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
# - 不同环境（开发/测试/生产）应使用不同的密钥
# - 定期轮换密钥以提升安全性
# - docker-compose 中使用 ${JWT_SECRET:?JWT_SECRET must be set} 强制要求设置
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRE_DAYS=7

# ==================== 数据库配置 ====================
# 开发环境使用 SQLite
DATABASE_URL=sqlite:///./data/sales.db

# 生产环境使用 MySQL
# DATABASE_URL=mysql+pymysql://aquatic_user:your-password@mysql:3306/aquatic_market

# MySQL 配置
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=aquatic_market
MYSQL_USER=aquatic_user
MYSQL_PASSWORD=your-password

# ==================== CORS 配置 ====================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5175

# ==================== 服务端口 ====================
MERCHANT_PORT=8001
CUSTOMER_PORT=8002
PLATFORM_PORT=8003

# ==================== 前端 API 配置 ====================
# 开发环境
API_BASE_URL_MERCHANT=http://localhost:8001
API_BASE_URL_CUSTOMER=http://localhost:8002
API_BASE_URL_PLATFORM=http://localhost:8003

# 生产环境（通过 Nginx）
# API_BASE_URL_MERCHANT=http://your-domain.com/api/merchant
# API_BASE_URL_CUSTOMER=http://your-domain.com/api/customer
# API_BASE_URL_PLATFORM=http://your-domain.com/api/platform