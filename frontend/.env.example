# 前端环境配置示例 — 复制为 .env 使用
# 开发环境：Vite dev server (npm run dev) 使用此文件

# 商家端 API（端口 8001）
VITE_API_BASE_URL=http://localhost:8001

# 用户端 API（端口 8002）
VITE_CUSTOMER_API_BASE_URL=http://localhost:8002

# 平台后台 API（端口 8003）
VITE_PLATFORM_API_URL=http://localhost:8003

# 生产环境：使用 .env.production，所有 URL 留空走 Nginx 反向代理